# ─── Tiketbisa Frontend — Environment Variables ───
# Copy this file to .env and fill in the values.

# Base URL for API calls (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth client ID (web application)
VITE_GOOGLE_AUTH_CLIENT_ID=your_google_auth_client_id_here

# Internal subdomain identifier (change when confirmed)
# Used by app/core/utils/subdomain.ts to detect partner dashboard
VITE_INTERNAL_SUBDOMAIN=internal
