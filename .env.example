# ─── Tiketbisa Frontend — Environment Variables ───
# Copy this file to .env and fill in the values.

# Base URL for API calls (no trailing slash)
# Browser-side URL. Use localhost when the backend publishes port 8080.
VITE_API_BASE_URL=http://localhost:8080

# Server-side URL for SSR/loaders when the frontend runs inside Docker.
# Leave empty for local pnpm dev outside Docker.
VITE_API_INTERNAL_BASE_URL=

# Google OAuth client ID (web application)
VITE_GOOGLE_AUTH_CLIENT_ID=your_google_auth_client_id_here

# Public manual-transfer instructions embedded in the production bundle.
VITE_MANUAL_TRANSFER_BANK_NAME=Mandiri
VITE_MANUAL_TRANSFER_ACCOUNT_NUMBER=your_account_number_here
VITE_MANUAL_TRANSFER_ACCOUNT_HOLDER=PT. Tiketbisa Digital Sejahtera
