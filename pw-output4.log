.brand-gradient {
  background: linear-gradient(135deg, #6d5cff 0%, #22c7a9 100%);
}
body {
  background-color: var(--color-base-white);
  color: var(--color-text-inverse);
}
@keyframes fadeInLeft {
  from {
    opacity: 0;
    transform: translateX(-20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes fadeInRight {
  from {
    opacity: 0;
    transform: translateX(20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes scroll-left-text {
  0%, 10% {
    transform: translateX(0);
  }
  90%, 100% {
    transform: translateX(-50%);
  }
}
.animate-scroll-left-text {
  display: inline-block;
  animation: scroll-left-text 8s linear infinite;
}
[data-theme="light"] {
  --color-surface-primary: #ffffff;
  --color-surface-alt: #ffffff;
  --color-surface-hover: #f3f4f6;
  --color-surface-inverse: #0f0b1f;
  --color-text-primary: #0f0b1f;
  --color-text-secondary: #4b5563;
  --color-text-tertiary: #6b7280;
  --color-text-inverse: #f5f3ff;
  --color-border-default: #e5e7eb;
  --color-border-subtle: #d1d5db;
  --color-divider: #e5e7eb;
  --color-button-disabled: #e5e7eb;
  --color-button-secondary-border: #d1d5db;
  --color-button-secondary-text: #4b5563;
  --color-button-ghost-text: #6d5cff;
  --color-success-bg: #f0fdf4;
  --color-success-text: #16a34a;
  --color-warning-bg: #fffbeb;
  --color-warning-text: #d97706;
  --color-destructive-bg: #fef2f2;
  --color-destructive-text: #dc2626;
  --color-brand-primary-subtle: #ede9fe;
  --color-brand-primary: #4c3fd1;
}
[data-trust-mode="true"] {
  --color-club-accent: var(--color-brand-primary);
  --color-club-accent-subtle: var(--color-brand-primary-subtle);
  --color-club-accent-text: #ffffff;
}
#qr-scanner-region video {
  border-radius: 0.5rem;
  object-fit: cover;
}
#qr-scanner-region img[alt="Info icon"] {
  display: none;
}
#qr-scanner-region__dashboard_section {
  display: none !important;
}
